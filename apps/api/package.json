{
  "name": "@sales/api",
  "version": "2.0.0",
  "private": true,
  "description": "Sales and management HTTP and WebSocket API",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.strict.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:migrate:undo": "tsx src/database/migrate.ts down",
    "db:migrate:status": "tsx src/database/migrate.ts pending",
    "db:v2:status": "tsx src/database/v2/migrate.ts status",
    "db:v2:up": "tsx src/database/v2/migrate.ts up",
    "db:seed": "tsx src/database/seed.ts",
    "db:migrate:prod": "node dist/database/migrate.js up",
    "db:seed:prod": "node dist/database/seed.js",
    "outbox:publish": "tsx src/workers/run-outbox-publisher.ts"
  },
  "dependencies": {
    "@redis/client": "^5.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^0.10.9",
    "axios": "^1.12.0",
    "bcryptjs": "^3.0.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dateformat": "^5.0.3",
    "dotenv": "^17.2.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "mustache": "^4.2.0",
    "mysql2": "^3.14.0",
    "qs": "^6.14.0",
    "resend": "^4.8.0",
    "sequelize": "^6.37.0",
    "socket.io": "^4.8.0",
    "umzug": "^3.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/dateformat": "^5.0.3",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
