Project HappyShop_Target_Schema_V2 {
  database_type: 'MySQL'
  Note: '''DESIGN revision 4 - compatibility-first fresh-database cutover scope approved on 2026-09-23.
This remains the schema contract input; executable baseline and MySQL verification are required before local cutover.
One common product price across online/offline. One fulfillment branch per order.
Open decisions, transaction invariants and review limits are in .phunglm/specs/database-v2.md and .phunglm/reviews/database-v2.md.'''
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

Enum account_status {
  pending
  active
  locked
  inactive
}

Enum role_scope_type {
  global
  branch
}

Enum customer_status {
  active
  inactive
  anonymized
}

Enum employee_status {
  active
  inactive
}

Enum branch_type {
  central
  branch
}

Enum product_status {
  draft
  active
  inactive
}

Enum order_channel {
  online
  in_store
}

Enum order_status {
  pending
  confirmed
  completed
  cancelled
}

Enum fulfillment_type {
  delivery
  store_pickup
  carry_out
}

Enum fulfillment_status {
  unfulfilled
  preparing
  ready_for_pickup
  shipping
  fulfilled
  exception
  cancelled
}

Enum payment_status {
  pending
  processing
  completed
  failed
  cancelled
}

Enum reservation_status {
  active
  consumed
  released
  expired
}

Enum shipment_status {
  pending
  booked
  shipping
  delivered
  failed
  returning
  returned
  cancelled
}

Enum refund_status {
  pending
  processing
  completed
  failed
  cancelled
}

Enum return_status {
  requested
  approved
  received
  inspected
  completed
  rejected
  cancelled
}

Enum voucher_channel {
  all
  online
  in_store
}

Enum voucher_branch_scope {
  all
  selected
}

Enum redemption_status {
  reserved
  redeemed
  released
}

Enum voucher_discount_type {
  percent
  fixed
}

Enum voucher_status {
  draft
  active
  inactive
  expired
}

Enum stock_request_status {
  pending
  approved
  rejected
  cancelled
  fulfilled
}

Enum transfer_status {
  pending
  approved
  in_transit
  completed
  rejected
  cancelled
}

Enum conversation_status {
  open
  waiting_staff
  closed
}

Enum conversation_reply_mode {
  bot
  human
  paused
}

Enum conversation_event_type {
  created
  handoff_requested
  claimed
  assigned
  routed
  mode_changed
  closed
  reopened
  assignee_released
}

Enum chat_message_type {
  text
  system_notice
}

Enum assistant_run_status {
  queued
  generating
  completed
  failed
  cancelled
  superseded
}

Enum message_sender_type {
  customer
  staff
  assistant
  system
}

Enum notification_type {
  order_new
  order_updated
  low_stock
  stock_request
  transfer_receipt
  system
}

Enum behavior_event_type {
  product_view
  product_like
  product_unlike
  add_to_cart
  purchase
}

//////////////////////////////////////////////////////////
// IDENTITY & ACCESS
//////////////////////////////////////////////////////////

Table accounts {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  username varchar(100) [unique]
  password_hash varchar(255) [note: 'Nullable for OAuth-only accounts; credential model is still under review']
  status account_status [not null, default: 'pending']
  email_verified_at timestamp
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table roles {
  id integer [pk, increment]
  code varchar(100) [not null, unique, note: 'CUSTOMER, SALES_STAFF, INVENTORY_STAFF, CUSTOMER_SUPPORT, BRANCH_MANAGER, SUPER_ADMIN']
  name varchar(150) [not null]
  description varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table permissions {
  id integer [pk, increment]
  code varchar(150) [not null, unique, note: 'Example: order.read.branch']
  description varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table role_permissions {
  id bigint [pk, increment]
  role_id integer [not null]
  permission_id integer [not null]
  created_at timestamp [not null]

  indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions_role_permission']
  }
}

Table account_roles {
  id bigint [pk, increment]
  account_id bigint [not null]
  role_id integer [not null]
  scope_type role_scope_type [not null, default: 'global']
  scope_key varchar(100) [not null, note: 'GLOBAL or BRANCH:<branch_id>; used to enforce unique nullable scope']
  branch_id bigint
  assigned_by_account_id bigint
  assigned_at timestamp [not null]

  indexes {
    (account_id, role_id, scope_key) [unique, name: 'uq_account_roles_account_role_scope']
    (branch_id, role_id) [name: 'idx_account_roles_branch_role']
  }

  checks {
    `(scope_type = 'global' AND branch_id IS NULL AND scope_key = 'GLOBAL') OR (scope_type = 'branch' AND branch_id IS NOT NULL AND scope_key = CONCAT('BRANCH:', branch_id))` [name: 'chk_account_role_scope']
  }
}

//////////////////////////////////////////////////////////
// CUSTOMERS & ORGANIZATION
//////////////////////////////////////////////////////////

Table customers {
  id bigint [pk, increment]
  account_id bigint [unique, note: 'Nullable for known customers without a login account']
  full_name varchar(255)
  phone varchar(30)
  status customer_status [not null, default: 'active']
  loyalty_points integer [not null, default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table customer_addresses {
  id bigint [pk, increment]
  customer_id bigint [not null]
  recipient_name varchar(255) [not null]
  recipient_phone varchar(30) [not null]
  address_line varchar(500) [not null]
  province_id integer
  district_id integer
  ward_code varchar(50)
  is_default boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    customer_id [name: 'idx_customer_addresses_customer']
  }
}

Table branches {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  address varchar(500) [not null]
  phone varchar(30)
  email varchar(255)
  type branch_type [not null, default: 'branch']
  manager_employee_id bigint [note: 'Operational manager pointer; authorization comes from scoped roles']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table employees {
  id bigint [pk, increment]
  account_id bigint [unique, note: 'Nullable when employee has no login access']
  branch_id bigint [not null]
  code varchar(50) [not null, unique]
  full_name varchar(255) [not null]
  position varchar(150)
  phone varchar(30)
  email varchar(255)
  salary decimal(19,4)
  status employee_status [not null, default: 'active']
  hired_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    branch_id [name: 'idx_employees_branch']
  }
}

//////////////////////////////////////////////////////////
// CATALOG
//////////////////////////////////////////////////////////

Table categories {
  id bigint [pk, increment]
  parent_id bigint
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  description text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table products {
  id bigint [pk, increment]
  category_id bigint [not null]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  description text
  base_price decimal(19,4) [not null, check: `base_price >= 0`, note: 'Common VND price for all channels/branches/sizes; no per-channel price table']
  images json
  status product_status [not null, default: 'draft']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    category_id [name: 'idx_products_category']
    (status, created_at) [name: 'idx_products_status_created']
  }
}

Table sizes {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table product_variants {
  id bigint [pk, increment]
  product_id bigint [not null]
  size_id bigint [not null]
  sku varchar(100) [not null, unique]
  status product_status [not null, default: 'active']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (product_id, size_id) [unique, name: 'uq_product_variants_product_size']
  }
}

Table reviews {
  id bigint [pk, increment]
  customer_id bigint [not null]
  product_id bigint [not null]
  order_item_id bigint [note: 'Optional link used to mark a verified purchase']
  rating integer [not null, check: `rating BETWEEN 1 AND 5`]
  review_text text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (customer_id, product_id) [unique, name: 'uq_reviews_customer_product']
    product_id [name: 'idx_reviews_product']
  }
}

Table banners {
  id bigint [pk, increment]
  name varchar(255) [not null]
  image json
  target_url varchar(1000)
  status product_status [not null, default: 'draft']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

//////////////////////////////////////////////////////////
// CARTS, ORDERS, VOUCHERS & PAYMENTS
//////////////////////////////////////////////////////////

Table carts {
  id bigint [pk, increment]
  customer_id bigint [not null, unique]
  Note: 'One reusable cart per customer. Checkout removes purchased items; cart does not become a historical order.'
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null]
  product_variant_id bigint [not null]
  quantity integer [not null, check: `quantity > 0`]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (cart_id, product_variant_id) [unique, name: 'uq_cart_items_cart_variant']
  }
}

Table orders {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  checkout_key varchar(191) [not null, unique, note: 'Retry key bound to actor and immutable checkout payload']
  customer_id bigint [note: 'Nullable for anonymous in-store orders']
  fulfillment_branch_id bigint [not null]
  created_by_account_id bigint [note: 'Actor that created an in-store/admin order']
  channel order_channel [not null]
  fulfillment_type fulfillment_type [not null]
  fulfillment_status fulfillment_status [not null, default: 'unfulfilled']
  status order_status [not null, default: 'pending']
  currency char(3) [not null, default: 'VND', check: `currency = 'VND'`]
  subtotal_amount decimal(19,4) [not null]
  discount_amount decimal(19,4) [not null, default: 0]
  shipping_fee decimal(19,4) [not null, default: 0]
  total_amount decimal(19,4) [not null]
  customer_name varchar(255) [note: 'Buyer snapshot; anonymous carry-out may omit PII']
  customer_email varchar(255)
  customer_phone varchar(30)
  customer_message varchar(1000)
  cancelled_at timestamp
  cancelled_by_account_id bigint
  cancellation_reason varchar(500)
  fulfilled_at timestamp
  placed_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (customer_id, created_at) [name: 'idx_orders_customer_created']
    (fulfillment_branch_id, status, created_at) [name: 'idx_orders_branch_status_created']
    (status, created_at) [name: 'idx_orders_status_created']
  }

  checks {
    `subtotal_amount >= 0 AND discount_amount >= 0 AND discount_amount <= subtotal_amount AND shipping_fee >= 0 AND total_amount = subtotal_amount - discount_amount + shipping_fee` [name: 'chk_order_amounts']
    `channel <> 'online' OR customer_id IS NOT NULL` [name: 'chk_online_customer']
    `channel <> 'in_store' OR created_by_account_id IS NOT NULL` [name: 'chk_pos_actor']
    `fulfillment_type <> 'carry_out' OR channel = 'in_store'` [name: 'chk_carry_out_channel']
    `fulfillment_type = 'delivery' OR shipping_fee = 0` [name: 'chk_nondelivery_fee']
    `status <> 'completed' OR fulfillment_status = 'fulfilled'` [name: 'chk_completed_fulfilled']
  }
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [note: 'Nullable for imported legacy rows; catalog referenced by new orders is retained']
  product_variant_id bigint [note: 'Required for new stock operations; legacy backfill must resolve the variant']
  sku_snapshot varchar(100) [not null]
  product_name_snapshot varchar(255) [not null]
  size_name_snapshot varchar(100) [not null]
  image_snapshot json
  unit_price decimal(19,4) [not null]
  discount_amount decimal(19,4) [not null, default: 0]
  quantity integer [not null, check: `quantity > 0`]
  line_total decimal(19,4) [not null]
  created_at timestamp [not null]

  indexes {
    order_id [name: 'idx_order_items_order']
    product_id [name: 'idx_order_items_product']
  }

  checks {
    `unit_price >= 0 AND discount_amount >= 0 AND discount_amount <= unit_price * quantity AND line_total = unit_price * quantity - discount_amount` [name: 'chk_order_item_amounts']
  }
}

Table order_status_history {
  id bigint [pk, increment]
  order_id bigint [not null]
  from_status order_status
  to_status order_status [not null]
  from_fulfillment_status fulfillment_status
  to_fulfillment_status fulfillment_status [not null]
  changed_by_account_id bigint
  note varchar(500)
  changed_at timestamp [not null]

  indexes {
    (order_id, changed_at) [name: 'idx_order_status_history_order_changed']
  }
}

Table vouchers {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  description varchar(500)
  discount_type voucher_discount_type [not null]
  discount_value decimal(19,4) [not null]
  min_order_amount decimal(19,4) [not null, default: 0]
  max_discount_amount decimal(19,4)
  usage_limit integer
  per_customer_limit integer
  applies_to_channel voucher_channel [not null, default: 'all']
  branch_scope voucher_branch_scope [not null, default: 'all']
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  status voucher_status [not null, default: 'draft']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Usage = reserved + redeemed redemptions. Lock voucher row before claiming. No independent used_count.'
  checks {
    `discount_value > 0 AND min_order_amount >= 0 AND (max_discount_amount IS NULL OR max_discount_amount >= 0)` [name: 'chk_voucher_amounts']
    `discount_type <> 'percent' OR discount_value <= 100` [name: 'chk_voucher_percent']
    `ends_at > starts_at` [name: 'chk_voucher_dates']
    `(usage_limit IS NULL OR usage_limit > 0) AND (per_customer_limit IS NULL OR per_customer_limit > 0)` [name: 'chk_voucher_limits']
  }
}

Table voucher_branches {
  voucher_id bigint [not null]
  branch_id bigint [not null]
  indexes {
    (voucher_id, branch_id) [pk]
  }
}

Table voucher_redemptions {
  id bigint [pk, increment]
  voucher_id bigint [not null]
  order_id bigint [not null, unique, note: 'Draft minimum: at most one voucher per order; released rows are retained']
  customer_id bigint
  voucher_code_snapshot varchar(50) [not null]
  discount_amount decimal(19,4) [not null, check: `discount_amount >= 0`]
  status redemption_status [not null, default: 'reserved']
  reserved_at timestamp [not null]
  redeemed_at timestamp
  released_at timestamp

  indexes {
    (voucher_id, status) [name: 'idx_voucher_redemptions_voucher_status']
    (customer_id, voucher_id) [name: 'idx_voucher_redemptions_customer_voucher']
  }
}

Table payment_methods {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  description varchar(500)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table payments {
  id bigint [pk, increment]
  order_id bigint [not null]
  payment_method_id bigint [not null]
  collected_by_account_id bigint
  provider varchar(50) [not null, note: 'Example: vnpay, cash, cod; COD is completed only when collection is verified']
  merchant_reference varchar(191) [not null, unique]
  provider_transaction_id varchar(191)
  amount decimal(19,4) [not null, check: `amount > 0`]
  status payment_status [not null, default: 'pending']
  paid_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (provider, provider_transaction_id) [unique, name: 'uq_payment_provider_transaction']
    (order_id, created_at) [name: 'idx_payments_order_created']
    (status, created_at) [name: 'idx_payments_status_created']
  }
  checks {
    `status <> 'completed' OR paid_at IS NOT NULL` [name: 'chk_payment_completion_time']
  }
  Note: 'One row per collection attempt/portion. Completed collections remain completed after refunds; derive net paid from refunds.'
}

Table payment_events {
  id bigint [pk, increment]
  payment_id bigint [not null]
  provider varchar(50) [not null]
  event_key varchar(191) [not null, note: 'Stable provider event id or canonical business-event key']
  event_type varchar(100) [not null]
  verified_at timestamp [not null]
  processed_at timestamp
  created_at timestamp [not null]
  indexes {
    (provider, event_key) [unique, name: 'uq_payment_event_provider_key']
    (payment_id, created_at) [name: 'idx_payment_events_payment_created']
  }
  Note: 'Verified event inbox. Never persist raw credentials or card details. Unprocessed events must be retried.'
}

//////////////////////////////////////////////////////////
// DELIVERY, RETURNS & REFUNDS
//////////////////////////////////////////////////////////

Table shipments {
  id bigint [pk, increment]
  order_id bigint [not null, unique]
  provider varchar(50) [not null]
  provider_request_key varchar(191) [not null, unique]
  provider_order_id varchar(191)
  tracking_number varchar(191)
  recipient_name varchar(255) [not null]
  recipient_phone varchar(30) [not null]
  shipping_address varchar(500) [not null]
  province_id integer
  district_id integer
  ward_code varchar(50)
  status shipment_status [not null, default: 'pending']
  carrier_fee decimal(19,4) [check: `carrier_fee IS NULL OR carrier_fee >= 0`, note: 'Carrier cost; independent of shipping fee charged on order']
  cod_amount decimal(19,4) [not null, default: 0, check: `cod_amount >= 0`]
  shipped_at timestamp
  delivered_at timestamp
  returned_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (provider, provider_order_id) [unique, name: 'uq_shipment_provider_order']
    (status, updated_at) [name: 'idx_shipments_status_updated']
  }
  checks {
    `CHAR_LENGTH(TRIM(recipient_name)) > 0 AND CHAR_LENGTH(TRIM(recipient_phone)) > 0 AND CHAR_LENGTH(TRIM(shipping_address)) > 0` [name: 'chk_shipment_recipient']
    `status <> 'delivered' OR delivered_at IS NOT NULL` [name: 'chk_shipment_delivery_time']
  }
  Note: 'Minimum scope: one logical whole-order shipment; no split shipment. Created with recipient snapshot in checkout transaction for delivery only.'
}

Table shipment_events {
  id bigint [pk, increment]
  shipment_id bigint [not null]
  event_key varchar(191) [not null]
  status shipment_status [not null]
  occurred_at timestamp [not null]
  received_at timestamp [not null]
  processed_at timestamp
  indexes {
    (shipment_id, event_key) [unique, name: 'uq_shipment_event_key']
    (shipment_id, occurred_at) [name: 'idx_shipment_events_timeline']
  }
}

Table returns {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  request_key varchar(191) [not null, unique]
  order_id bigint [not null]
  receiving_branch_id bigint [not null]
  created_by_account_id bigint
  approved_by_account_id bigint
  processed_by_account_id bigint
  status return_status [not null, default: 'requested']
  reason varchar(500) [not null]
  approved_at timestamp
  received_at timestamp
  inspected_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (order_id, status) [name: 'idx_returns_order_status']
  }
}

Table return_items {
  id bigint [pk, increment]
  return_id bigint [not null]
  order_item_id bigint [not null]
  requested_quantity integer [not null]
  approved_quantity integer [not null, default: 0]
  received_quantity integer [not null, default: 0]
  restocked_quantity integer [not null, default: 0]
  non_sellable_quantity integer [not null, default: 0]
  approved_refund_amount decimal(19,4) [not null, default: 0]
  note varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (return_id, order_item_id) [unique, name: 'uq_return_items_return_order_item']
  }
  checks {
    `requested_quantity > 0 AND approved_quantity >= 0 AND approved_quantity <= requested_quantity AND received_quantity >= 0 AND received_quantity <= approved_quantity` [name: 'chk_return_quantities']
    `restocked_quantity >= 0 AND non_sellable_quantity >= 0 AND restocked_quantity + non_sellable_quantity <= received_quantity AND approved_refund_amount >= 0` [name: 'chk_return_disposition']
  }
}

Table refunds {
  id bigint [pk, increment]
  payment_id bigint [not null]
  return_id bigint [note: 'Nullable for cancellation, failed delivery or excess/late payment refunds']
  idempotency_key varchar(191) [not null, unique]
  provider_refund_id varchar(191)
  amount decimal(19,4) [not null, check: `amount > 0`]
  status refund_status [not null, default: 'pending']
  reason varchar(500) [not null]
  requested_by_account_id bigint
  approved_by_account_id bigint
  processed_by_account_id bigint
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (payment_id, provider_refund_id) [unique, name: 'uq_refund_payment_provider_reference']
    (payment_id, status) [name: 'idx_refunds_payment_status']
    return_id [name: 'idx_refunds_return']
  }
  checks {
    `status <> 'completed' OR completed_at IS NOT NULL` [name: 'chk_refund_completion_time']
  }
  Note: 'Order is derived through payment. Related return must have the same order. Pending/processing/completed amounts reserve the refund budget.'
}

//////////////////////////////////////////////////////////
// INVENTORY & STOCK WORKFLOW
//////////////////////////////////////////////////////////

Table inventories {
  id bigint [pk, increment]
  branch_id bigint [not null]
  product_variant_id bigint [not null]
  stock integer [not null, default: 0, check: `stock >= 0`, note: 'Sellable on-hand units, including held units. Available = stock - SUM(active reservations).']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (branch_id, product_variant_id) [unique, name: 'uq_inventories_branch_variant']
  }
}

Table inventory_reservations {
  id bigint [pk, increment]
  inventory_id bigint [not null]
  order_item_id bigint
  transfer_receipt_item_id bigint
  quantity integer [not null, check: `quantity > 0`]
  status reservation_status [not null, default: 'active']
  expires_at timestamp [note: 'Only unconfirmed unpaid holds expire; confirmed/COD holds have no payment timeout']
  confirmed_at timestamp
  consumed_at timestamp
  released_at timestamp
  idempotency_key varchar(191) [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (inventory_id, status) [name: 'idx_reservations_inventory_status']
    (status, expires_at) [name: 'idx_reservations_expiry']
    order_item_id [name: 'idx_reservations_order_item']
    transfer_receipt_item_id [name: 'idx_reservations_transfer_item']
  }
  checks {
    `(order_item_id IS NOT NULL AND transfer_receipt_item_id IS NULL) OR (order_item_id IS NULL AND transfer_receipt_item_id IS NOT NULL)` [name: 'chk_reservation_owner']
    `status <> 'consumed' OR consumed_at IS NOT NULL` [name: 'chk_reservation_consumed_time']
    `status NOT IN ('released', 'expired') OR released_at IS NOT NULL` [name: 'chk_reservation_released_time']
    `confirmed_at IS NULL OR expires_at IS NULL` [name: 'chk_confirmed_reservation_expiry']
  }
}

Table inventory_movements {
  id bigint [pk, increment]
  branch_id bigint [not null]
  product_variant_id bigint [not null]
  quantity_delta integer [not null, check: `quantity_delta <> 0`]
  balance_after integer [not null, check: `balance_after >= 0`]
  order_item_id bigint
  transfer_receipt_item_id bigint
  return_item_id bigint
  reason varchar(100) [not null]
  reference_type varchar(100) [not null]
  reference_id varchar(100) [not null]
  idempotency_key varchar(191) [not null, unique]
  created_by_account_id bigint
  occurred_at timestamp [not null]
  created_at timestamp [not null]

  indexes {
    (branch_id, product_variant_id, occurred_at) [name: 'idx_inventory_movements_ledger']
    (reference_type, reference_id) [name: 'idx_inventory_movements_reference']
  }
  checks {
    `(CASE WHEN order_item_id IS NULL THEN 0 ELSE 1 END) + (CASE WHEN transfer_receipt_item_id IS NULL THEN 0 ELSE 1 END) + (CASE WHEN return_item_id IS NULL THEN 0 ELSE 1 END) <= 1` [name: 'chk_movement_single_source']
  }
}

Table stock_requests {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  from_branch_id bigint [not null]
  to_branch_id bigint [not null]
  status stock_request_status [not null, default: 'pending']
  created_by_account_id bigint [not null]
  approved_by_account_id bigint
  approved_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  checks {
    `from_branch_id <> to_branch_id` [name: 'chk_stock_request_branches']
  }
  Note: 'from_branch is requesting/receiving branch; to_branch is supplying branch. Physical transfer direction is reversed.'
}

Table stock_request_items {
  id bigint [pk, increment]
  stock_request_id bigint [not null]
  product_variant_id bigint [not null]
  quantity integer [not null, check: `quantity > 0`]
  note varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (stock_request_id, product_variant_id) [unique, name: 'uq_stock_request_items_request_variant']
  }
}

Table stock_request_history {
  id bigint [pk, increment]
  stock_request_id bigint [not null]
  action varchar(100) [not null]
  performed_by_account_id bigint [not null]
  note varchar(500)
  created_at timestamp [not null]

  indexes {
    (stock_request_id, created_at) [name: 'idx_stock_request_history_request_created']
  }
}

Table transfer_receipts {
  id bigint [pk, increment]
  stock_request_id bigint
  code varchar(50) [not null, unique]
  from_branch_id bigint [not null]
  to_branch_id bigint [not null]
  status transfer_status [not null, default: 'pending']
  created_by_account_id bigint [not null]
  approved_by_account_id bigint
  approved_at timestamp
  dispatched_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    stock_request_id [name: 'idx_transfer_receipts_stock_request']
    (from_branch_id, to_branch_id, status) [name: 'idx_transfer_receipts_route_status']
  }
  checks {
    `from_branch_id <> to_branch_id` [name: 'chk_transfer_branches']
  }
}

Table transfer_receipt_items {
  id bigint [pk, increment]
  transfer_receipt_id bigint [not null]
  product_variant_id bigint [not null]
  quantity integer [not null, note: 'Must be greater than 0']
  received_quantity integer [not null, default: 0]
  lost_quantity integer [not null, default: 0]
  non_sellable_quantity integer [not null, default: 0]
  note varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (transfer_receipt_id, product_variant_id) [unique, name: 'uq_transfer_receipt_items_receipt_variant']
  }
  checks {
    `quantity > 0 AND received_quantity >= 0 AND lost_quantity >= 0 AND non_sellable_quantity >= 0 AND received_quantity + lost_quantity + non_sellable_quantity <= quantity` [name: 'chk_transfer_quantities']
  }
}

Table transfer_history {
  id bigint [pk, increment]
  transfer_receipt_id bigint [not null]
  action varchar(100) [not null]
  performed_by_account_id bigint [not null]
  note varchar(500)
  created_at timestamp [not null]

  indexes {
    (transfer_receipt_id, created_at) [name: 'idx_transfer_history_receipt_created']
  }
}

//////////////////////////////////////////////////////////
// COMMUNICATION & PERSONALIZATION
//////////////////////////////////////////////////////////

Table conversations {
  id bigint [pk, increment]
  customer_id bigint [not null]
  branch_id bigint [note: 'NULL = central support queue; not automatic access for every branch']
  assigned_account_id bigint
  subject varchar(255)
  status conversation_status [not null, default: 'open']
  reply_mode conversation_reply_mode [not null, default: 'paused']
  version bigint [not null, default: 0, check: `version >= 0`]
  last_message_seq bigint [not null, default: 0, check: `last_message_seq >= 0`]
  mode_changed_by_account_id bigint
  mode_changed_at timestamp [not null]
  handoff_requested_at timestamp
  last_message_at timestamp
  closed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (customer_id, created_at) [name: 'idx_conversations_customer_created']
    (branch_id, status, last_message_at, id) [name: 'idx_conversations_branch_queue']
    (assigned_account_id, status, last_message_at, id) [name: 'idx_conversations_assignee_queue']
  }
  checks {
    `reply_mode <> 'human' OR (status = 'open' AND assigned_account_id IS NOT NULL)` [name: 'chk_conversation_human_owner']
    `reply_mode <> 'bot' OR (status = 'open' AND assigned_account_id IS NULL)` [name: 'chk_conversation_bot_owner']
    `status <> 'waiting_staff' OR (reply_mode = 'paused' AND assigned_account_id IS NULL AND handoff_requested_at IS NOT NULL)` [name: 'chk_conversation_waiting_staff']
    `(status = 'closed' AND reply_mode = 'paused' AND assigned_account_id IS NULL AND closed_at IS NOT NULL) OR (status <> 'closed' AND closed_at IS NULL)` [name: 'chk_conversation_closed_state']
    `(last_message_seq = 0 AND last_message_at IS NULL) OR (last_message_seq > 0 AND last_message_at IS NOT NULL)` [name: 'chk_conversation_message_cursor']
  }
  Note: 'One non-closed conversation per customer is a service invariant under customer-row lock. Mode/assignment/routing/lifecycle changes increment version and append an audit event atomically. New conversations opt into bot explicitly only when configured; safe DB default is paused.'
}

Table messages {
  id bigint [pk, increment]
  conversation_id bigint [not null]
  seq bigint [not null, check: `seq > 0`]
  sender_account_id bigint
  sender_type message_sender_type [not null]
  message_type chat_message_type [not null, default: 'text']
  dedup_key varchar(191) [not null, note: 'Server-normalized actor/intent namespace; stable across retries']
  request_hash char(64) [not null, note: 'Canonical input hash; same key with different input is rejected']
  reply_to_message_id bigint
  content text [not null]
  metadata json [note: 'Typed allowlist only; no internal notes, secrets or raw model/provider responses']
  created_at timestamp [not null]

  indexes {
    (conversation_id, seq) [unique, name: 'uq_messages_conversation_seq']
    (conversation_id, dedup_key) [unique, name: 'uq_messages_conversation_dedup']
    (conversation_id, created_at) [name: 'idx_messages_conversation_created']
  }
  checks {
    `(sender_type IN ('customer', 'staff') AND sender_account_id IS NOT NULL) OR (sender_type IN ('assistant', 'system') AND sender_account_id IS NULL)` [name: 'chk_message_sender_identity']
    `(sender_type = 'system' AND message_type = 'system_notice') OR (sender_type <> 'system' AND message_type = 'text')` [name: 'chk_message_sender_content_type']
    `CHAR_LENGTH(TRIM(content)) > 0` [name: 'chk_message_nonempty_content']
  }
  Note: 'Persisted public transcript only. Reply target must be in this conversation and earlier in seq; enforced by service. Allocate seq and outbox atomically under conversation lock. Read receipts are per account, not a single message.read_at.'
}

Table conversation_events {
  id bigint [pk, increment]
  conversation_id bigint [not null]
  event_type conversation_event_type [not null]
  actor_account_id bigint [note: 'NULL only for authenticated internal system actions']
  from_mode conversation_reply_mode
  to_mode conversation_reply_mode [not null]
  from_assignee_id bigint
  to_assignee_id bigint
  from_branch_id bigint
  to_branch_id bigint
  from_status conversation_status
  to_status conversation_status [not null]
  version_after bigint [not null, check: `version_after >= 0`]
  command_key varchar(191) [not null]
  request_hash char(64) [not null]
  reason_code varchar(100)
  created_at timestamp [not null]
  indexes {
    (conversation_id, command_key) [unique, name: 'uq_conversation_events_command']
    (conversation_id, version_after) [unique, name: 'uq_conversation_events_version']
    (conversation_id, created_at, id) [name: 'idx_conversation_events_timeline']
  }
  checks {
    `(event_type = 'created' AND version_after = 0 AND from_mode IS NULL AND from_status IS NULL AND from_assignee_id IS NULL AND from_branch_id IS NULL) OR (event_type <> 'created' AND version_after > 0 AND from_mode IS NOT NULL AND from_status IS NOT NULL)` [name: 'chk_conversation_event_origin']
    `to_mode <> 'human' OR (to_status = 'open' AND to_assignee_id IS NOT NULL)` [name: 'chk_conversation_event_human']
    `to_mode <> 'bot' OR (to_status = 'open' AND to_assignee_id IS NULL)` [name: 'chk_conversation_event_bot']
    `to_status = 'open' OR (to_mode = 'paused' AND to_assignee_id IS NULL)` [name: 'chk_conversation_event_inactive']
  }
  Note: 'Append-only internal audit, not customer-visible messages. One full control-state snapshot per committed version, including version 0 on create. Match before/after state and increment version in the same transaction; client cannot choose actor or snapshots.'
}

Table conversation_read_states {
  conversation_id bigint [not null]
  account_id bigint [not null]
  last_read_seq bigint [not null, default: 0, check: `last_read_seq >= 0`]
  read_at timestamp [not null]
  indexes {
    (conversation_id, account_id) [pk]
    account_id [name: 'idx_conversation_reads_account']
  }
  Note: 'Read watermark per account. Service enforces current access, monotonic progress and seq <= conversation.last_message_seq; this row grants no membership or permission.'
}

Table assistant_runs {
  id bigint [pk, increment]
  conversation_id bigint [not null]
  trigger_message_id bigint [not null]
  expected_version bigint [not null, check: `expected_version >= 0`]
  context_last_seq bigint [not null, check: `context_last_seq > 0`]
  status assistant_run_status [not null, default: 'queued']
  attempt_count integer [not null, default: 0, check: `attempt_count >= 0`]
  next_attempt_at timestamp
  lease_token char(36)
  lease_expires_at timestamp
  response_message_id bigint [unique]
  model_name varchar(150)
  error_code varchar(100)
  created_at timestamp [not null]
  started_at timestamp
  completed_at timestamp
  indexes {
    (conversation_id, trigger_message_id) [unique, name: 'uq_assistant_runs_trigger']
    (status, next_attempt_at, id) [name: 'idx_assistant_runs_ready']
    (status, lease_expires_at, id) [name: 'idx_assistant_runs_lease']
  }
  checks {
    `(status = 'generating' AND lease_token IS NOT NULL AND lease_expires_at IS NOT NULL AND started_at IS NOT NULL AND attempt_count > 0) OR (status <> 'generating' AND lease_token IS NULL AND lease_expires_at IS NULL)` [name: 'chk_assistant_run_lease']
    `(status = 'queued' AND next_attempt_at IS NOT NULL) OR (status <> 'queued' AND next_attempt_at IS NULL)` [name: 'chk_assistant_run_schedule']
    `(status IN ('completed', 'failed', 'cancelled', 'superseded') AND completed_at IS NOT NULL) OR (status IN ('queued', 'generating') AND completed_at IS NULL)` [name: 'chk_assistant_run_terminal_time']
    `(status = 'completed' AND response_message_id IS NOT NULL AND started_at IS NOT NULL AND attempt_count > 0) OR (status <> 'completed' AND response_message_id IS NULL)` [name: 'chk_assistant_run_response']
  }
  Note: 'Schema only: does not enable an AI worker. Trigger must be a customer message and response an assistant message in the same conversation. Commit under conversation-then-run lock only if bot/open, expected_version, context_last_seq and lease token still match. One output per trigger; no raw prompt/transcript copies. External AI calls happen outside DB transactions.'
}

Table notifications {
  id bigint [pk, increment]
  recipient_account_id bigint [not null]
  type notification_type [not null]
  title varchar(255) [not null]
  content varchar(1000) [not null]
  data json
  read_at timestamp
  created_at timestamp [not null]

  indexes {
    (recipient_account_id, read_at, created_at) [name: 'idx_notifications_recipient_read_created']
  }
}

Table behavior_events {
  id bigint [pk, increment]
  customer_id bigint [note: 'Nullable only if anonymous behavior is approved later']
  anonymous_session_id varchar(100)
  product_id bigint [not null]
  event_type behavior_event_type [not null]
  event_data json
  occurred_at timestamp [not null]
  created_at timestamp [not null]

  indexes {
    (customer_id, occurred_at) [name: 'idx_behavior_events_customer_occurred']
    (product_id, event_type, occurred_at) [name: 'idx_behavior_events_product_type_occurred']
  }
}

Table customer_product_stats {
  id bigint [pk, increment]
  customer_id bigint [not null]
  product_id bigint [not null]
  view_count integer [not null, default: 0]
  is_liked boolean [not null, default: false]
  last_viewed_at timestamp
  updated_at timestamp [not null]

  indexes {
    (customer_id, product_id) [unique, name: 'uq_customer_product_stats_customer_product']
    (customer_id, updated_at) [name: 'idx_customer_product_stats_customer_updated']
  }
}

//////////////////////////////////////////////////////////
// ASYNC INTEGRATION
//////////////////////////////////////////////////////////

Table outbox_events {
  id bigint [pk, increment]
  event_id char(36) [not null, unique, note: 'UUID string; native uuid is not a MySQL type']
  event_type varchar(100) [not null]
  aggregate_type varchar(100) [not null]
  aggregate_id varchar(100) [not null]
  payload json [not null]
  occurred_at timestamp [not null]
  published_at timestamp
  attempts integer [not null, default: 0]
  locked_at timestamp
  last_error text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (published_at, locked_at, id) [name: 'idx_outbox_events_dispatch']
  }
}

//////////////////////////////////////////////////////////
// RELATIONSHIPS
// Declared after all tables for dbdiagram compatibility.
//////////////////////////////////////////////////////////

Ref: role_permissions.role_id > roles.id [delete: restrict, update: restrict]
Ref: role_permissions.permission_id > permissions.id [delete: restrict, update: restrict]
Ref: account_roles.account_id > accounts.id [delete: restrict, update: restrict]
Ref: account_roles.role_id > roles.id [delete: restrict, update: restrict]
Ref: account_roles.branch_id > branches.id [delete: restrict, update: restrict]
Ref: account_roles.assigned_by_account_id > accounts.id [delete: restrict, update: restrict]

Ref: accounts.id - customers.account_id [delete: restrict, update: restrict]
Ref: customer_addresses.customer_id > customers.id [delete: restrict, update: restrict]
Ref: accounts.id - employees.account_id [delete: restrict, update: restrict]
Ref: employees.branch_id > branches.id [delete: restrict, update: restrict]
Ref: branches.manager_employee_id > employees.id [delete: restrict, update: restrict]

Ref: categories.parent_id > categories.id [delete: restrict, update: restrict]
Ref: products.category_id > categories.id [delete: restrict, update: restrict]
Ref: product_variants.product_id > products.id [delete: restrict, update: restrict]
Ref: product_variants.size_id > sizes.id [delete: restrict, update: restrict]
Ref: reviews.customer_id > customers.id [delete: restrict, update: restrict]
Ref: reviews.product_id > products.id [delete: restrict, update: restrict]
Ref: reviews.order_item_id > order_items.id [delete: restrict, update: restrict]

Ref: customers.id - carts.customer_id [delete: restrict, update: restrict]
Ref: cart_items.cart_id > carts.id [delete: cascade, update: restrict]
Ref: cart_items.product_variant_id > product_variants.id [delete: restrict, update: restrict]
Ref: orders.customer_id > customers.id [delete: restrict, update: restrict]
Ref: orders.fulfillment_branch_id > branches.id [delete: restrict, update: restrict]
Ref: orders.created_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: orders.cancelled_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: order_items.order_id > orders.id [delete: restrict, update: restrict]
Ref: order_items.product_id > products.id [delete: restrict, update: restrict]
Ref: order_items.product_variant_id > product_variants.id [delete: restrict, update: restrict]
Ref: order_status_history.order_id > orders.id [delete: restrict, update: restrict]
Ref: order_status_history.changed_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: voucher_redemptions.voucher_id > vouchers.id [delete: restrict, update: restrict]
Ref: voucher_redemptions.order_id > orders.id [delete: restrict, update: restrict]
Ref: voucher_redemptions.customer_id > customers.id [delete: restrict, update: restrict]
Ref: payments.order_id > orders.id [delete: restrict, update: restrict]
Ref: payments.payment_method_id > payment_methods.id [delete: restrict, update: restrict]
Ref: payments.collected_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: payment_events.payment_id > payments.id [delete: restrict, update: restrict]
Ref: voucher_branches.voucher_id > vouchers.id [delete: restrict, update: restrict]
Ref: voucher_branches.branch_id > branches.id [delete: restrict, update: restrict]
Ref: orders.id - shipments.order_id [delete: restrict, update: restrict]
Ref: shipment_events.shipment_id > shipments.id [delete: restrict, update: restrict]
Ref: returns.order_id > orders.id [delete: restrict, update: restrict]
Ref: returns.receiving_branch_id > branches.id [delete: restrict, update: restrict]
Ref: returns.created_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: returns.approved_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: returns.processed_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: return_items.return_id > returns.id [delete: restrict, update: restrict]
Ref: return_items.order_item_id > order_items.id [delete: restrict, update: restrict]
Ref: refunds.payment_id > payments.id [delete: restrict, update: restrict]
Ref: refunds.return_id > returns.id [delete: restrict, update: restrict]
Ref: refunds.requested_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: refunds.approved_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: refunds.processed_by_account_id > accounts.id [delete: restrict, update: restrict]

Ref: inventories.branch_id > branches.id [delete: restrict, update: restrict]
Ref: inventories.product_variant_id > product_variants.id [delete: restrict, update: restrict]
Ref: inventory_movements.branch_id > branches.id [delete: restrict, update: restrict]
Ref: inventory_movements.product_variant_id > product_variants.id [delete: restrict, update: restrict]
Ref: inventory_movements.created_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: inventory_movements.order_item_id > order_items.id [delete: restrict, update: restrict]
Ref: inventory_movements.transfer_receipt_item_id > transfer_receipt_items.id [delete: restrict, update: restrict]
Ref: inventory_movements.return_item_id > return_items.id [delete: restrict, update: restrict]
Ref: inventory_reservations.inventory_id > inventories.id [delete: restrict, update: restrict]
Ref: inventory_reservations.order_item_id > order_items.id [delete: restrict, update: restrict]
Ref: inventory_reservations.transfer_receipt_item_id > transfer_receipt_items.id [delete: restrict, update: restrict]
Ref: stock_requests.from_branch_id > branches.id [delete: restrict, update: restrict]
Ref: stock_requests.to_branch_id > branches.id [delete: restrict, update: restrict]
Ref: stock_requests.created_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: stock_requests.approved_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: stock_request_items.stock_request_id > stock_requests.id [delete: restrict, update: restrict]
Ref: stock_request_items.product_variant_id > product_variants.id [delete: restrict, update: restrict]
Ref: stock_request_history.stock_request_id > stock_requests.id [delete: restrict, update: restrict]
Ref: stock_request_history.performed_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: transfer_receipts.stock_request_id > stock_requests.id [delete: restrict, update: restrict]
Ref: transfer_receipts.from_branch_id > branches.id [delete: restrict, update: restrict]
Ref: transfer_receipts.to_branch_id > branches.id [delete: restrict, update: restrict]
Ref: transfer_receipts.created_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: transfer_receipts.approved_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: transfer_receipt_items.transfer_receipt_id > transfer_receipts.id [delete: restrict, update: restrict]
Ref: transfer_receipt_items.product_variant_id > product_variants.id [delete: restrict, update: restrict]
Ref: transfer_history.transfer_receipt_id > transfer_receipts.id [delete: restrict, update: restrict]
Ref: transfer_history.performed_by_account_id > accounts.id [delete: restrict, update: restrict]

Ref: conversations.customer_id > customers.id [delete: restrict, update: restrict]
Ref: conversations.branch_id > branches.id [delete: restrict, update: restrict]
Ref: conversations.assigned_account_id > accounts.id [delete: restrict, update: restrict]
Ref: conversations.mode_changed_by_account_id > accounts.id [delete: restrict, update: restrict]
Ref: messages.conversation_id > conversations.id [delete: restrict, update: restrict]
Ref: messages.sender_account_id > accounts.id [delete: restrict, update: restrict]
Ref: messages.reply_to_message_id > messages.id [delete: restrict, update: restrict]
Ref: conversation_events.conversation_id > conversations.id [delete: restrict, update: restrict]
Ref: conversation_events.actor_account_id > accounts.id [delete: restrict, update: restrict]
Ref: conversation_events.from_assignee_id > accounts.id [delete: restrict, update: restrict]
Ref: conversation_events.to_assignee_id > accounts.id [delete: restrict, update: restrict]
Ref: conversation_events.from_branch_id > branches.id [delete: restrict, update: restrict]
Ref: conversation_events.to_branch_id > branches.id [delete: restrict, update: restrict]
Ref: conversation_read_states.conversation_id > conversations.id [delete: restrict, update: restrict]
Ref: conversation_read_states.account_id > accounts.id [delete: restrict, update: restrict]
Ref: assistant_runs.conversation_id > conversations.id [delete: restrict, update: restrict]
Ref: assistant_runs.trigger_message_id > messages.id [delete: restrict, update: restrict]
Ref: assistant_runs.response_message_id > messages.id [delete: restrict, update: restrict]
Ref: notifications.recipient_account_id > accounts.id [delete: restrict, update: restrict]
Ref: behavior_events.customer_id > customers.id [delete: restrict, update: restrict]
Ref: behavior_events.product_id > products.id [delete: restrict, update: restrict]
Ref: customer_product_stats.customer_id > customers.id [delete: restrict, update: restrict]
Ref: customer_product_stats.product_id > products.id [delete: restrict, update: restrict]
