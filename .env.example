NODE_ENV=development

# API
API_PORT=8080
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=btl_tmdt
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
DEFAULT_FULFILLMENT_BRANCH_ID=13

# Redis
REDIS_URL=redis://localhost:6379

# Vector search (local Qdrant; change this key for every shared environment)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=local-qdrant-key-change-me

# Asynchronous jobs (local RabbitMQ; do not use the default guest account)
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=sales_app
RABBITMQ_DEFAULT_PASS=local-rabbitmq-password-change-me
RABBITMQ_DEFAULT_VHOST=sales_dev

# Internal services
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Browser build-time configuration
VITE_API_ORIGIN=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# External integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BRANCH_ID=
GHN_BRANCH_DISTRICT_ID=

# VNPay
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8080/api/v1/payment-return
PAYMENT_WEBHOOK_SECRET=
