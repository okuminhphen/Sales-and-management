# Immutable images produced and pushed by CI. Pin a release tag or commit SHA, never latest.
API_IMAGE=ghcr.io/your-org/sales-api:replace-with-git-sha
WEB_IMAGE=ghcr.io/your-org/sales-web:replace-with-git-sha
AI_IMAGE=ghcr.io/your-org/sales-ai:replace-with-git-sha

# Host reverse proxy -> web container
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
FRONTEND_URL=https://shop.example.com

# Managed infrastructure. Keep the real values in the deployment platform secret store.
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=sale_and_managements_db
MYSQL_USER=replace-me
MYSQL_PASSWORD=replace-me
DEFAULT_FULFILLMENT_BRANCH_ID=13
REDIS_URL=rediss://replace-me@redis.example.internal:6379
RABBITMQ_URL=amqps://replace-me@rabbitmq.example.internal/production
QDRANT_ENABLED=true
QDRANT_URL=https://qdrant.example.internal
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=catalog_products_v1
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_PRODUCT_LIMIT=8
RAG_DESCRIPTION_CHAR_LIMIT=400
CHAT_HISTORY_TURN_LIMIT=6
CHAT_MAX_OUTPUT_TOKENS=800
AI_SERVICE_TIMEOUT_MS=10000
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Application secrets/providers
JWT_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=replace-me
GOOGLE_CLIENT_ID=
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=replace-with-production-recaptcha-secret
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=shop.example.com
RECAPTCHA_TIMEOUT_MS=5000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-production-resend-api-key
EMAIL_FROM=HappyShop <no-reply@yourdomain.com>
OTP_HMAC_SECRET=replace-with-a-strong-hmac-secret-min-32-chars
EMAIL_TIMEOUT_MS=5000
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BRANCH_ID=
GHN_BRANCH_DISTRICT_ID=
VNP_TMN_CODE=replace-me
VNP_HASH_SECRET=replace-me
VNP_URL=https://pay.vnpay.vn/vpcpay.html
VNP_RETURN_URL=https://shop.example.com/api/v1/payment-return
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
